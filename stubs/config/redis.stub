---
to: config/redis.ts
---
import { defineConfig } from '@c9up/quasar'
import env from '#start/env'

export default defineConfig({
  // The connection `redis.connection()` hands back with no argument.
  connection: 'main',

  connections: {
    main: {
      host: env.get('REDIS_HOST'),
      port: env.get('REDIS_PORT'),
      password: env.get('REDIS_PASSWORD'),
      db: 0,
      keyPrefix: '',
      // Give up after ten attempts instead of retrying forever: a command
      // issued during an outage then fails in about three seconds, and the
      // next call opens a fresh connection.
      retryStrategy(times) {
        return times > 10 ? null : times * 50
      },
    },
  },
})
